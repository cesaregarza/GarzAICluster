{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "smsReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "suspend",
        "secretName",
        "verifiedImageTag",
        "commandCompatibleImageTags",
        "schedule",
        "timeZone",
        "concurrencyPolicy",
        "startingDeadlineSeconds",
        "activeDeadlineSeconds",
        "backoffLimit",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "staleMinutes",
        "limit",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "verifiedImageTag": {
          "type": "string"
        },
        "commandCompatibleImageTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Forbid"]
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 1
        },
        "staleMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"]
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"]
            }
          }
        }
      }
    }
  }
}
