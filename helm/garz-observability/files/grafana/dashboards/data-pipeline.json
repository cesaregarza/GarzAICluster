{
  "uid": "data-pipelines",
  "title": "Data Pipelines",
  "tags": ["splattop", "celery"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Celery Task Runtime (Avg)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "expr": "max(celery_task_runtime_seconds_avg) by (task)",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Celery Task Failures",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "expr": "sum(rate(celery_task_failures_total[5m])) by (task)",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Minutes Since Last Completion",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7},
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {"align": "auto"}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {"show": false, "fields": "*", "reducer": ["last"]}
      },
      "targets": [
        {
          "expr": "(time() - max(celery_task_last_finished_timestamp_seconds) by (task)) / 60",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Data Pull Duration (P95/P50)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 7},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (task, le) (rate(celery_data_pull_duration_seconds_bucket[5m])))",
          "legendFormat": "{{task}} P95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (task, le) (rate(celery_data_pull_duration_seconds_bucket[5m])))",
          "legendFormat": "{{task}} P50"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Data Pull Row Counts",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 14},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"align": "auto"}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {"show": false, "fields": "*", "reducer": ["last"]}
      },
      "targets": [
        {
          "expr": "max(celery_data_pull_rows) by (task)",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Table Refresh Duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 14},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 2},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (table, le) (rate(fastapi_table_refresh_duration_seconds_bucket[5m])))",
          "legendFormat": "{{table}} P95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (table, le) (rate(fastapi_table_refresh_duration_seconds_bucket[5m])))",
          "legendFormat": "{{table}} P50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RSS Before Task",
      "description": "Worker process RSS immediately before the latest completed task. Different task completions may come from different worker processes; this is not total worker memory. One Redis-backed sample is shared by API replicas; max by task removes duplicate scrapes. See Minutes Since Last Completion for sample age.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "max(celery_task_rss_before_bytes) by (task)",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RSS After Task",
      "description": "Worker process RSS immediately after the latest completed task. Use sustained elevated current RSS to investigate retained memory. One Redis-backed sample is shared by API replicas; max by task removes duplicate scrapes. See Minutes Since Last Completion for sample age.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "max(celery_task_rss_after_bytes) by (task)",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RSS Change Across Task",
      "description": "Signed difference between paired before/after process RSS readings. May be negative; measures process memory change, not unique task allocations. One Redis-backed sample is shared by API replicas; max by task removes duplicate scrapes. See Minutes Since Last Completion for sample age.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "max(celery_task_rss_delta_bytes) by (task)",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Process Lifetime RSS High-Water Mark",
      "description": "Process lifetime high-water mark seen at the latest task completion. This is not the task peak and stays high after memory is released; do not use it alone to trigger recycling. One Redis-backed sample is shared by API replicas; max by task removes duplicate scrapes. See Minutes Since Last Completion for sample age.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "max(celery_task_process_rss_high_water_bytes) by (task)",
          "legendFormat": "{{task}}"
        }
      ]
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m", "1h"]}
}
